<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
<meta name="theme-color" content="#4a210d" />
<title>O Gaúcho — Desafio das Taças</title>
<style>
  :root{
    --wood1:#2b1208; --wood2:#6b2e12; --wood3:#3a1609;
    --gold:#f4c062; --cream:#fff3d4; --orange:#c76a1d;
    --glass-w: clamp(72px, 19vw, 114px);
    --bowl-h: clamp(138px, 35vw, 204px);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#130d0a;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#fff;touch-action:manipulation}
  button{font:inherit}
  #app{position:relative;width:100%;height:100%;overflow:hidden;background:
      linear-gradient(180deg, rgba(14,8,5,.70) 0%, rgba(13,8,5,.45) 42%, rgba(8,5,4,.82) 100%),
      url("https://images.unsplash.com/photo-1779085592560-979558afb688?auto=format&fit=crop&w=1800&q=82") center center / cover no-repeat,
      linear-gradient(180deg,#271711 0%,#120b08 58%,#0b0706 100%);}
  #app:before{content:"";position:absolute;inset:0;pointer-events:none;background:
      radial-gradient(circle at 50% 20%,rgba(255,208,122,.10),transparent 28%),
      linear-gradient(180deg,rgba(255,255,255,.03),rgba(0,0,0,.24));}

  /* CAPA */
  #cover{position:absolute;inset:0;z-index:30;background:#2c1208;display:flex;align-items:center;justify-content:center;overflow:hidden}
  #cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none;user-select:none}
  #cover .fade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,6,4,.18),rgba(10,6,4,.10) 46%,rgba(0,0,0,.42));pointer-events:none}
  #startHotspot,#rankingHotspot,#howHotspot{position:absolute;border:0;background:transparent;cursor:pointer;z-index:50;padding:0;margin:0;-webkit-tap-highlight-color:transparent;touch-action:manipulation;pointer-events:auto}
  #startHotspot{left:15.5%;width:69%;top:73.0%;height:13.8%;border-radius:34px}
  #rankingHotspot{left:5.0%;width:44.5%;top:88.5%;height:9.7%;border-radius:28px}
  #howHotspot{left:51.0%;width:44%;top:88.5%;height:9.7%;border-radius:28px}
  #startHotspot:active,#rankingHotspot:active,#howHotspot:active{background:rgba(255,255,255,.06)}
  #coverHint{position:absolute;bottom:max(12px,env(safe-area-inset-bottom));font-size:12px;letter-spacing:.5px;opacity:.0;pointer-events:none}

  /* JOGO */
  #game{position:absolute;inset:0;display:none;flex-direction:column;z-index:1}
  .topbar{padding:calc(10px + env(safe-area-inset-top)) 12px 0;display:grid;grid-template-columns:54px 1fr 54px;align-items:center;gap:8px;position:relative;z-index:6;width:min(100%,620px);margin:0 auto;background:linear-gradient(180deg,rgba(10,6,4,.50),rgba(10,6,4,0));backdrop-filter:blur(1px)}
  .roundBtn{width:50px;height:50px;border-radius:50%;border:2px solid rgba(255,224,166,.55);background:linear-gradient(#c8782f,#8f471b);box-shadow:0 4px 0 #5b2a0e,0 6px 12px #0008,inset 0 2px 2px #ffd18f80;color:#fff;font-weight:900;font-size:22px;display:grid;place-items:center;cursor:pointer}
  .roundBtn:active{transform:translateY(2px);box-shadow:0 2px 0 #5b2a0e,0 4px 8px #0008}
  .titleBox{text-align:center;filter:drop-shadow(0 2px 2px #000a)}
  .titleBox .brand{font-size:clamp(18px,5.2vw,27px);font-weight:900;letter-spacing:.6px;color:#fff1d4;text-transform:uppercase}
  .subtitle{font-size:11px;opacity:.80;margin-top:3px;color:#f5c283;letter-spacing:.7px;text-transform:uppercase}

  .infoRow{position:relative;z-index:6;width:min(100%,620px);margin:10px auto 0;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:0 12px}
  .infoCard{min-height:72px;border-radius:20px;border:2px solid #e0a55c;background:linear-gradient(180deg,rgba(117,56,21,.96),rgba(82,35,12,.96));box-shadow:0 5px 0 #4d220d,0 10px 18px #0005;color:#fff6e8;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:10px 8px;text-align:center}
  .infoCard .statLabel{font-size:11px;font-weight:900;letter-spacing:1px;color:#ffd8a0;text-transform:uppercase}
  .infoCard .statValue{font-size:24px;line-height:1.05;font-weight:1000;color:#ffffff;margin-top:3px}
  .infoAction{cursor:pointer}
  .infoAction small{display:block;margin-top:3px;font-size:10px;color:#ffe6bd;opacity:.9}
  .infoAction:active{transform:translateY(2px);box-shadow:0 3px 0 #4d220d,0 6px 12px #0005}

  .bottleLine{position:absolute;top:222px;left:50%;transform:translateX(-50%);width:min(100%,760px);display:grid;grid-template-columns:repeat(5,1fr);align-items:end;justify-items:center;pointer-events:none;z-index:1;padding:0;}
  .bgBottleSlot{position:relative;width:100%;height:536px;display:flex;align-items:flex-end;justify-content:center;}
  .bgBottle{height:520px !important;max-height:520px !important;width:auto !important;max-width:98%;object-fit:contain;filter:drop-shadow(0 18px 18px rgba(0,0,0,.42));opacity:.99}
  .bgBottleName{position:absolute;left:50%;bottom:-12px;transform:translateX(-50%);font-size:28px;font-weight:1000;line-height:1;text-align:center;color:#fff7e0;text-shadow:0 2px 6px rgba(0,0,0,.98),0 0 12px rgba(0,0,0,.62);white-space:nowrap;letter-spacing:.3px;pointer-events:none}
  .bottleLine .bgBottleSlot:nth-child(1) .bgBottle,
  .bottleLine .bgBottleSlot:nth-child(4) .bgBottle{transform:scaleX(.86);transform-origin:bottom center}
    
  #boardWrap{position:relative;flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:620px 6px 24px;z-index:2}
  #board{width:min(100%,540px);display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(6px,1.8vw,12px) clamp(4px,1vw,8px);justify-items:center;align-items:end;position:relative;z-index:2}
  .gameActions{position:relative;z-index:8;margin-top:10px;display:flex;justify-content:center;width:100%}
  .undoBtn{border:2px solid #e0a55c;border-radius:16px;padding:10px 18px;background:linear-gradient(180deg,#a65420,#75320f);color:#fff6e8;font-size:14px;font-weight:900;letter-spacing:.3px;box-shadow:0 4px 0 #4d220d,0 8px 14px #0006;cursor:pointer;min-width:160px}
  .undoBtn:active{transform:translateY(2px);box-shadow:0 2px 0 #4d220d,0 5px 10px #0006}
  .undoBtn:disabled{opacity:.45;filter:grayscale(.4);cursor:default}
  .slot{position:relative;width:100%;height:calc(var(--bowl-h) + 68px);display:flex;align-items:flex-start;justify-content:center;cursor:pointer;user-select:none;transition:filter .15s ease}
  .slot:nth-child(n+6){grid-column:auto}
  .slot.selected{filter:drop-shadow(0 0 18px #fff1b8) drop-shadow(0 0 12px #ffb347);transform:translateY(-4px)}
  .slot.invalid{animation:shake .22s linear 2}
  @keyframes shake{25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}

  .glass{position:absolute;top:0;left:50%;width:var(--glass-w);height:calc(var(--bowl-h) + 66px);transform:translateX(-50%);transform-origin:50% 18%;z-index:3;will-change:transform;pointer-events:none}
  .bowl{position:absolute;left:0;top:0;width:100%;height:var(--bowl-h);border:3px solid rgba(255,255,255,.78);border-top-width:4px;border-radius:18px 18px 42% 42% / 14px 14px 30% 30%;background:linear-gradient(100deg,rgba(255,255,255,.16),rgba(255,255,255,.04) 25%,rgba(255,255,255,.01) 57%,rgba(255,255,255,.16));box-shadow:inset 4px 0 7px #fff3,inset -5px 0 7px #0002,0 4px 10px #0006;overflow:hidden}
  .bowl:before{content:"";position:absolute;left:5%;right:5%;top:2px;height:5px;border-top:2px solid rgba(255,255,255,.95);border-radius:50%;z-index:5;filter:drop-shadow(0 1px 1px #0006)}
  .liquidStack{position:absolute;left:3px;right:3px;bottom:3px;height:calc(100% - 6px);display:flex;flex-direction:column-reverse;justify-content:flex-start;overflow:hidden;border-radius:0 0 42% 42% / 0 0 30% 30%;z-index:1}
  .layer{position:relative;min-height:0;box-shadow:inset 0 9px 10px rgba(255,255,255,.08),inset 0 -6px 8px rgba(0,0,0,.07);transition:height .22s ease,transform .22s ease}
  .layer:before{content:"";position:absolute;left:0;right:0;top:-3px;height:7px;border-radius:50%;background:rgba(255,255,255,.12)}
  .layer.purple{background:linear-gradient(#a855e8,#7d2fd0)}
  .layer.yellow{background:linear-gradient(#f8df6a,#e0b72f)}
  .layer.green{background:linear-gradient(#41c75d,#208f3a)}
  .layer.pink{background:linear-gradient(#f48bdc,#dd58bf)}
  .layer.red{background:linear-gradient(#fb554d,#d72e2a)}
  .stem{position:absolute;top:calc(var(--bowl-h) - 1px);left:50%;width:8px;height:43px;transform:translateX(-50%);background:linear-gradient(90deg,#fff9,#fff3,#fff8);border-left:1px solid #fff9;border-right:1px solid #fff7;box-shadow:0 1px 3px #0007}
  .base{position:absolute;top:calc(var(--bowl-h) + 39px);left:50%;width:64%;height:15px;transform:translateX(-50%);border:3px solid #ffffffc9;border-radius:50%;background:linear-gradient(#ffffff26,#ffffff08);box-shadow:0 4px 8px #0007,inset 0 2px 2px #fff4}
  .cork{display:none;position:absolute;left:50%;top:-9px;width:66%;height:13px;transform:translateX(-50%);border-radius:7px 7px 4px 4px;background:linear-gradient(#e7bb72,#b97e39);border:1px solid #8e5d28;box-shadow:inset 0 2px 2px #fff5,0 2px 4px #0008;z-index:6}
  .slot.done .cork{display:block;animation:pop .3s ease}
  .slot.done{filter:drop-shadow(0 0 8px #ffd865)}
  @keyframes pop{from{transform:translateX(-50%) translateY(-12px);opacity:0}to{transform:translateX(-50%) translateY(0);opacity:1}}

  #pourStream{position:fixed;z-index:20;width:13px;height:0;opacity:0;pointer-events:none;transform-origin:top center;border-radius:999px;overflow:visible;box-shadow:0 0 12px rgba(255,255,255,.18);transition:height .18s ease,opacity .12s ease,transform .12s ease}
  #pourStream:before{content:"";position:absolute;left:2px;top:0;bottom:0;width:3px;border-radius:999px;background:rgba(255,255,255,.36);filter:blur(.2px)}
  #pourStream:after{content:"";position:absolute;left:50%;bottom:-9px;width:30px;height:16px;transform:translateX(-50%);border-radius:50%;background:inherit;filter:brightness(1.1) blur(.3px);opacity:.95;box-shadow:0 0 12px rgba(255,255,255,.12)}
  #pourStream.on{opacity:.98;animation:streamPulse .28s ease-in-out infinite alternate}
  @keyframes streamPulse{from{filter:saturate(1) brightness(1);margin-left:0}to{filter:saturate(1.08) brightness(1.07);margin-left:1px}}

  /* MODAIS */
  .modal{position:absolute;inset:0;background:rgba(11,4,1,.78);z-index:50;display:none;align-items:center;justify-content:center;padding:18px;backdrop-filter:blur(5px)}
  .modal.show{display:flex}
  .panel{width:min(92vw,390px);border-radius:24px;padding:23px 18px;background:linear-gradient(#6e2e11,#351306);border:3px solid #c97631;box-shadow:0 18px 50px #000b,inset 0 2px 0 #ffd08f66;text-align:center}
  .panel h2{margin:0 0 8px;color:#ffe4ad;font-size:28px}.panel p{margin:5px 0 18px;color:#f7dfc5}.panel .big{font-size:46px;font-weight:1000;color:#ffd86a;text-shadow:0 3px 0 #8a4500}
  .panelBtns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}.panelBtn{border:0;border-radius:16px;padding:12px 18px;font-weight:900;color:#fff;background:linear-gradient(#d8792c,#a94c17);box-shadow:0 4px 0 #6b2b0c;cursor:pointer}.panelBtn.green{background:linear-gradient(#45d42d,#15961b);box-shadow:0 4px 0 #075d0c}
  .rankList{margin:16px 0 10px;display:flex;flex-direction:column;gap:8px}
  .rankRow{display:grid;grid-template-columns:42px 1.5fr 1fr;gap:8px;align-items:center;padding:9px 10px;border-radius:14px;background:rgba(255,255,255,.08);color:#fff2d4;font-weight:800}
  .rankRow span:last-child{text-align:right}
  .emptyRank{padding:14px 12px;border-radius:14px;background:rgba(255,255,255,.08);color:#ffe3bc;font-weight:700}

  .nameInput{width:100%;height:50px;border-radius:14px;border:2px solid #d9964b;background:#fff8ec;color:#3d1b0b;font-size:18px;font-weight:800;text-align:center;outline:none;padding:0 12px;margin:8px 0 6px;box-shadow:inset 0 2px 5px #0002}
  .nameInput:focus{border-color:#ffd078;box-shadow:0 0 0 3px rgba(255,208,120,.18),inset 0 2px 5px #0002}
  .nameError{min-height:18px;color:#ffb2a6;font-size:12px;font-weight:800;margin:2px 0 10px}
  .playerBadge{position:absolute;left:50%;top:calc(57px + env(safe-area-inset-top));transform:translateX(-50%);font-size:10px;font-weight:800;color:#f7dfc5;opacity:.92;white-space:nowrap;z-index:7;pointer-events:none}
  #toast{position:absolute;left:50%;top:170px;transform:translateX(-50%) translateY(-12px);background:#1d0d06e8;border:1px solid #f7bd67;color:#ffe5be;padding:8px 12px;border-radius:999px;font-size:12px;font-weight:800;opacity:0;z-index:45;pointer-events:none;transition:.2s}
  #toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

  @media (max-height:700px){
    :root{--bowl-h:126px;--glass-w:66px}
    .roundBtn{width:46px;height:46px}
    .infoCard{min-height:64px}
    .infoCard .statValue{font-size:20px}
    .bottleLine{top:176px}
    .bgBottleSlot{height:416px}
    .bgBottle{height:398px !important;max-height:398px !important;width:auto !important}
    .bgBottleName{font-size:22px;bottom:-10px}
    #boardWrap{padding-top:514px;padding-bottom:16px}
    .slot{height:calc(var(--bowl-h) + 62px)}
  }
  @media (max-width:480px){
    :root{--glass-w:64px;--bowl-h:120px}
    .bottleLine,#board{width:min(100%,520px)}
    .titleBox .brand{font-size:16px}
    .subtitle{font-size:10px}
    .infoRow{gap:8px;padding:0 10px}
    .infoCard{min-height:66px;padding:8px 6px}
    .infoCard .statLabel{font-size:10px}
    .infoCard .statValue{font-size:21px}
    .bottleLine{top:182px}
    .bgBottleSlot{height:448px}
    .bgBottle{height:430px !important;max-height:430px !important;width:auto !important}
    .bgBottleName{font-size:18px;bottom:-10px;white-space:normal;max-width:120px;line-height:1.02;font-weight:1000}
    #boardWrap{padding:546px 4px 16px}
    #board{gap:6px 3px}
    .slot{height:calc(var(--bowl-h) + 60px)}
  }
  @media (min-width:600px){#board{gap:15px 10px}}
</style>
</head>
<body>
<div id="app">
  <section id="cover" aria-label="Capa do jogo">
    <img alt="Capa O Gaúcho — Jogo das Taças" src="data:image/png;base64,