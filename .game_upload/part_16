" alt="Tinto Suave"><div class="bgBottleName">Tinto Suave</div></div>
    </div>

    <main id="boardWrap">
      <div id="board" aria-label="Tabuleiro"></div>
    </main>
  </section>

  <div id="pourStream"></div>
  <div id="toast"></div>

  <div class="modal" id="nameModal"><div class="panel"><h2>NOME DO JOGADOR</h2><p>Digite seu nome antes de iniciar a partida.</p><input class="nameInput" id="playerNameInput" maxlength="24" autocomplete="off" placeholder="Seu nome"><div class="nameError" id="nameError"></div><div class="panelBtns"><button class="panelBtn green" id="confirmNameBtn">INICIAR</button><button class="panelBtn" id="cancelNameBtn">VOLTAR</button></div></div></div>
  <div class="modal" id="pauseModal"><div class="panel"><h2>Jogo pausado</h2><p>Seu progresso está preservado.</p><div class="panelBtns"><button class="panelBtn green" id="resumeBtn">RETORNAR</button><button class="panelBtn" id="pauseResetBtn">REINICIAR</button><button class="panelBtn" id="pauseHomeBtn">CAPA</button></div></div></div>
  <div class="modal" id="helpModal"><div class="panel"><h2>COMO JOGAR</h2><p>Toque em uma taça e depois em outra para derramar apenas o líquido do topo.</p><p>Você pode derramar para qualquer taça que tenha espaço. Se houver 2 ou mais camadas seguidas da mesma cor no topo, todas elas são derramadas juntas para agilizar a jogada.</p><p>Objetivo: deixar cada taça com uma cor só e exatamente na posição da garrafa correspondente acima.</p><div class="panelBtns"><button class="panelBtn green" id="closeHelpBtn">ENTENDI</button></div></div></div>
  <div class="modal" id="rankingModal"><div class="panel"><h2>RANKING</h2><p>Ranking por menor número de movimentos. Em caso de empate, vence o menor tempo. Cada nova rodada embaralha os líquidos.</p><div class="rankList" id="rankingList"></div><div class="panelBtns"><button class="panelBtn green" id="closeRankingBtn">FECHAR</button><button class="panelBtn" id="clearRankingBtn">LIMPAR</button></div></div></div>
  <div class="modal" id="winModal"><div class="panel"><div class="big">🏆</div><h2>PARABÉNS!</h2><p>Parabéns! Você completou o desafio!</p><p><b id="finalPlayer">Jogador</b>, conclusão em <b id="finalMoves">0</b> movimentos, no tempo de <b id="finalTime">00:00</b>.</p><div class="panelBtns"><button class="panelBtn green" id="playAgainBtn">JOGAR NOVAMENTE</button><button class="panelBtn" id="winHomeBtn">CAPA</button></div></div></div>
  <div class="modal" id="loseModal"><div class="panel"><div class="big">⏰</div><h2>QUE PENA!</h2><p>Que pena! O tempo acabou.</p><p><b id="losePlayer">Jogador</b>, você fez <b id="loseMoves">0</b> movimentos em <b id="loseTime">02:00</b>.</p><div class="panelBtns"><button class="panelBtn green" id="loseAgainBtn">TENTAR NOVAMENTE</button><button class="panelBtn" id="loseHomeBtn">CAPA</button></div></div></div>
</div>

<script>
(() => {
  const CAPACITY = 5;
  const GOAL_COUNT = 4;
  const TARGETS = ['yellow','purple','pink','green','red'];
  const BOTTLE_NAMES = ['Branco Seco','Tinto Seco','Rosé Suave','Branco Suave','Tinto Suave'];
  // Cada rodada começa com as 5 taças contendo líquido.
  // Cada taça tem espaço para mais 1 camada, permitindo a movimentação.
  const COLOR_POOL = TARGETS.flatMap(c=>Array(GOAL_COUNT).fill(c));
  const COLOR_HEX = {
    yellow:'#e5bf3d', purple:'#8f39d6', pink:'#e76bdf', green:'#21a946', red:'#da3831'
  };

  const TOTAL_TIME = 120;
  let initialState = [], state = [], selected = null, history = [], moves = 0, busy = false, paused = false, elapsed = 0, timeLeft = TOTAL_TIME, timerId = null, playerName = '', gameOver = false, lastTickWarn = null;
  const board = document.getElementById('board');
  const movesEl = document.getElementById('moves');
  const timeEl = document.getElementById('timeDisplay');
  const rankingHint = document.getElementById('rankingHint');
  const playerBadge = document.getElementById('playerBadge');
  const playerNameInput = document.getElementById('playerNameInput');
  const nameError = document.getElementById('nameError');
  const stream = document.getElementById('pourStream');
  const toast = document.getElementById('toast');
  const undoTopBtn = document.getElementById('undoTopBtn');
  const cover = document.getElementById('cover');
  const game = document.getElementById('game');
  const RANK_KEY = 'ogaucho_tacas_ranking_v2';
  let audioCtx = null;
  let musicTimer = null, musicStep = 0;

  function clone(v){ return v.map(a=>[...a]); }
  function serialize(v){ return v.map(a=>a.join(',')).join('|'); }
  function topColor(i, src=state){ const a=src[i]; return a.length ? a[a.length-1] : null; }
  function contiguousTop(i, src=state){
    const a=src[i];
    if(!a.length) return 0;
    const c=a[a.length-1];
    let n=0;
    for(let k=a.length-1; k>=0 && a[k]===c; k--) n++;
    return n;
  }
  function isDone(i, src=state){
    const a=src[i];
    return a.length===GOAL_COUNT && a.every(x=>x===TARGETS[i]);
  }
  function canPour(from,to, src=state){
    if(from===to || !src[from].length || src[to].length>=CAPACITY) return false;
    return true;
  }
  function transferable(from,to, src=state){
    if(!canPour(from,to,src)) return 0;
    return Math.min(contiguousTop(from,src), CAPACITY-src[to].length);
  }
  function checkWinState(src){
    return src.every((a,i)=>a.length===GOAL_COUNT && a.every(x=>x===TARGETS[i]));
  }
  function shuffleArray(arr){
    for(let i=arr.length-1;i>0;i--){
      const j=Math.floor(Math.random()*(i+1));
      [arr[i],arr[j]]=[arr[j],arr[i]];
    }
    return arr;
  }
  function goalState(){ return TARGETS.map(c=>Array(GOAL_COUNT).fill(c)); }
  function getValidMoves(src){
    const moves=[];
    for(let from=0; from<src.length; from++){
      for(let to=0; to<src.length; to++){
        if(canPour(from,to,src)) moves.push([from,to]);
      }
    }
    return moves;
  }
  function generateRound(maxAttempts=80){
    const pool=TARGETS.flatMap(c=>Array(GOAL_COUNT).fill(c));
    for(let attempt=0; attempt<maxAttempts; attempt++){
      const shuffled=shuffleArray([...pool]);
      const candidate=[];
      for(let i=0;i<5;i++) candidate.push(shuffled.slice(i*GOAL_COUNT,(i+1)*GOAL_COUNT));
      if(checkWinState(candidate)) continue;
      const mixedCount=candidate.filter(t=>new Set(t).size>=2).length;
      if(mixedCount<4) continue;
      if(getValidMoves(candidate).length) return candidate;
    }
    return [
      ['yellow','purple','pink','green'],
      ['red','yellow','purple','pink'],
      ['green','red','yellow','purple'],
      ['pink','green','red','yellow'],
      ['purple','pink','green','red']
    ];
  }

  function formatTime(sec){ const m=String(Math.floor(sec/60)).padStart(2,'0'); const s=String(sec%60).padStart(2,'0'); return `${m}:${s}`; }
  function updateTime(){
    timeEl.textContent = formatTime(timeLeft);
    if(timeLeft<=5){
      timeEl.style.color='#ffe38a';
      timeEl.style.textShadow='0 0 10px rgba(255,227,138,.55)';
    }else{
      timeEl.style.color='';
      timeEl.style.textShadow='';
    }
  }
  function stopTimer(){ if(timerId){ clearInterval(timerId); timerId = null; } }
  function tickTock(){ try{ensureAudio(); const now=audioCtx.currentTime; const o=audioCtx.createOscillator(), g=audioCtx.createGain(); o.type='square'; o.frequency.setValueAtTime(1080, now); g.gain.setValueAtTime(.0001, now); g.gain.exponentialRampToValueAtTime(.09, now+.01); g.gain.exponentialRampToValueAtTime(.001, now+.16); o.connect(g).connect(audioCtx.destination); o.start(now); o.stop(now+.17);}catch(e){} }
  function startTimer(){
    stopTimer();
    timerId = setInterval(()=>{
      if(paused || game.style.display!=='flex' || gameOver) return;
      if(timeLeft>0){
        timeLeft--;
        elapsed++;
        if(timeLeft<=5 && timeLeft>0){ tickTock(); }
        updateTime();
        if(timeLeft<=0){ lose(); }
      }
    },1000);
  }
  function getRanking(){ try{ return JSON.parse(localStorage.getItem(RANK_KEY)||'[]'); }catch(e){ return []; } }
  function saveRanking(list){ try{ localStorage.setItem(RANK_KEY, JSON.stringify(list)); }catch(e){} }
  function refreshRankingHint(){ const top=getRanking()[0]; rankingHint.textContent = top ? `Melhor ${top.moves} mov.` : 'Ver pontuações'; }
  function renderRanking(){ const list=getRanking(); const el=document.getElementById('rankingList'); if(!list.length){ el.innerHTML='<div class="emptyRank">Ainda não há pontuações registradas.</div>'; refreshRankingHint(); return; } el.innerHTML=list.map((r,i)=>`<div class="rankRow"><span>#${i+1}</span><span>${escapeHtml(r.name||'Jogador')}<br><small>${formatTime(r.time)}</small></span><span>${r.moves} mov.</span></div>`).join(''); refreshRankingHint(); }
  function addRankingEntry(){ const list=getRanking(); list.push({name:playerName||'Jogador',time:elapsed,moves,date:Date.now()}); list.sort((a,b)=> a.moves-b.moves || a.time-b.time || a.date-b.date); saveRanking(list.slice(0,10)); renderRanking(); }
  function escapeHtml(v){ return String(v).replace(/[&<>'"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])); }
  function askPlayerName(){
    nameError.textContent='';
    playerNameInput.value=playerName || '';
    showModal('nameModal');
    setTimeout(()=>playerNameInput.focus(),80);
  }
  function confirmPlayerName(){
    const name=playerNameInput.value.trim().replace(/\s+/g,' ');
    if(!name){ nameError.textContent='Digite o nome do jogador para iniciar.'; playerNameInput.focus(); return; }
    playerName=name.slice(0,24);
    playerBadge.textContent='Jogador: '+playerName;
    hideModal('nameModal');
    startGame();
  }
  function openRanking(){ if(busy) return; if(game.style.display==='flex' && !gameOver){ paused=true; stopTimer(); stopArcadeMusic(); } renderRanking(); showModal('rankingModal'); clickTone(260,.05); }
  function closeRanking(){ hideModal('rankingModal'); if(game.style.display==='flex' && !gameOver){ paused=false; startTimer(); startArcadeMusic(); } }
  function openHelp(){ if(game.style.display==='flex' && !gameOver){ paused=true; stopTimer(); stopArcadeMusic(); } showModal('helpModal'); clickTone(300,.05); }
  function closeHelp(){ hideModal('helpModal'); if(game.style.display==='flex' && !gameOver){ paused=false; startTimer(); startArcadeMusic(); } }

  function render(){
    board.innerHTML='';
    state.forEach((layers,i)=>{
      const slot=document.createElement('div'); slot.className='slot slot-'+TARGETS[i]+(selected===i?' selected':'')+(isDone(i)?' done':''); slot.dataset.i=i; slot.dataset.target=TARGETS[i]; slot.setAttribute('aria-label','Taça de '+BOTTLE_NAMES[i]+' — objetivo: '+TARGETS[i]);
      const glass=document.createElement('div'); glass.className='glass'; glass.innerHTML='<div class="bowl"><div class="liquidStack"></div></div><div class="stem"></div><div class="base"></div><div class="cork"></div>';
      const stack=glass.querySelector('.liquidStack');
      const unit=(100/CAPACITY).toFixed(4)+'%';
      layers.forEach(c=>{ const d=document.createElement('div'); d.className='layer '+c; d.style.height=unit; d.style.flex='0 0 '+unit; stack.appendChild(d); });
      slot.appendChild(glass); board.appendChild(slot);
      slot.addEventListener('pointerup',()=>tap(i));
    });
    movesEl.textContent=moves;
    if(undoTopBtn){ undoTopBtn.disabled = busy || history.length===0; undoTopBtn.style.opacity = history.length ? '1' : '.45'; }
    updateTime();
  }

  function tap(i){
    if(busy || paused || gameOver || isDone(i) && selected===null) return;
    if(selected===null){
      if(!state[i].length) return;
      selected=i; render(); lift(i,true); clickTone(340,.05); return;
    }
    const from=selected;
    if(i===from){ selected=null; render(); clickTone(220,.04); return; }
    if(!canPour(from,i)){
      const bad=document.querySelector('.slot[data-i="'+i+'"]'); if(bad){bad.classList.add('invalid');setTimeout(()=>bad.classList.remove('invalid'),450)}
      clickTone(120,.08); return;
    }
    selected=null;
    pour(from,i);
  }

  function lift(i,on){ const el=document.querySelector('.slot[data-i="'+i+'"] .glass'); if(el) el.style.transform=on?'translateX(-50%) translateY(-10px)':'translateX(-50%)'; }

  async function pour(from,to){
    busy=true;
    const count=transferable(from,to);
    const color=topColor(from);
    history.push({state:clone(state),moves});

    const fromSlot=document.querySelector('.slot[data-i="'+from+'"]');
    const toSlot=document.querySelector('.slot[data-i="'+to+'"]');
    const glass=fromSlot.querySelector('.glass');
    const fr=glass.getBoundingClientRect();
    const tb=toSlot.querySelector('.bowl').getBoundingClientRect();
    const fromCenterX = fr.left + fr.width/2;
    const toCenterX = tb.left + tb.width/2;
    const dir = toCenterX > fromCenterX ? 1 : -1;
    const hoverX = (toCenterX - fromCenterX) * 0.92;
    const hoverY = (tb.top - fr.top) - Math.max(fr.height*0.72, 122);
    const tiltY = hoverY + 6;
    const tiltAngle = dir * 70;

    const fly=glass.animate([
      {transform:'translateX(-50%) translateY(-10px) rotate(0deg)'},
      {transform:`translateX(calc(-50% + ${hoverX*0.28}px)) translateY(${hoverY*0.40}px) rotate(${dir*3}deg)`,offset:.24},
      {transform:`translateX(calc(-50% + ${hoverX*0.70}px)) translateY(${hoverY*0.88}px) rotate(${dir*4}deg)`,offset:.66},
      {transform:`translateX(calc(-50% + ${hoverX}px)) translateY(${hoverY}px) rotate(0deg)`}
    ],{duration:720,easing:'cubic-bezier(.22,.84,.23,1)',fill:'forwards'});
    await fly.finished.catch(()=>{});

    const tilt=glass.animate([
      {transform:`translateX(calc(-50% + ${hoverX}px)) translateY(${hoverY}px) rotate(0deg)`},
      {transform:`translateX(calc(-50% + ${hoverX}px)) translateY(${tiltY}px) rotate(${tiltAngle}deg)`}
    ],{duration:240,easing:'ease-out',fill:'forwards'});
    await tilt.finished.catch(()=>{});

    const finalCenterX = fromCenterX + hoverX;
    const finalTop = fr.top + tiltY;
    const spoutX = finalCenterX + dir*(fr.width*0.24);
    const spoutY = finalTop + fr.height*0.17;
    const destX = tb.left + tb.width*0.50;
    const destY = tb.top + Math.max(18, tb.height*0.18);
    const dx = destX - spoutX;
    const dy = destY - spoutY;
    const streamH = Math.max(92, Math.hypot(dx,dy));
    const streamRot = (Math.atan2(dy,dx) * 180 / Math.PI) - 90;
    const liquid = COLOR_HEX[color] || '#ffffff';
    stream.style.left=spoutX+'px';
    stream.style.top=spoutY+'px';
    stream.style.width=Math.max(11, fr.width*0.13)+'px';
    stream.style.background=`linear-gradient(90deg, rgba(255,255,255,.20) 0%, ${liquid} 20%, ${liquid} 76%, rgba(255,255,255,.14) 100%)`;
    stream.style.height='0px';
    stream.style.transform=`translateX(-50%) rotate(${streamRot}deg)`;
    stream.classList.add('on');
    requestAnimationFrame(()=>stream.style.height=streamH+'px');
    pourSound(true);

    for(let n=0;n<count;n++){
      await sleep(260);
      state[from].pop();
      state[to].push(color);
      renderStaticDuringPour(from,to,glass);
    }

    await sleep(150);
    renderStaticDuringPour(from,to,glass);
    stream.style.height='0px';
    await sleep(120);
    stream.classList.remove('on');
    stream.style.transform='translateX(-50%) rotate(0deg)';
    pourSound(false);

    const untilt=glass.animate([
      {transform:`translateX(calc(-50% + ${hoverX}px)) translateY(${tiltY}px) rotate(${tiltAngle}deg)`},
      {transform:`translateX(calc(-50% + ${hoverX}px)) translateY(${hoverY}px) rotate(0deg)`}
    ],{duration:220,easing:'ease-in-out',fill:'forwards'});
    await untilt.finished.catch(()=>{});

    const back=glass.animate([
      {transform:`translateX(calc(-50% + ${hoverX}px)) translateY(${hoverY}px) rotate(0deg)`},
      {transform:`translateX(calc(-50% + ${hoverX*0.56}px)) translateY(${hoverY*0.74}px) rotate(${dir*2}deg)`,offset:.34},
      {transform:`translateX(calc(-50% + ${hoverX*0.18}px)) translateY(${hoverY*0.26}px) rotate(${-dir*1}deg)`,offset:.74},
      {transform:'translateX(-50%) translateY(0) rotate(0deg)'}
    ],{duration:620,easing:'cubic-bezier(.34,.05,.26,1)',fill:'forwards'});
    await back.finished.catch(()=>{});

    moves++;
    busy=false;
    render();
    if(gameOver) return;
    if(isDone(to)){ completionTone(); }
    if(checkWin()){ setTimeout(win,500); }
  }

  // Rebuilds liquid stacks while keeping the pouring glass itself in place during the animation.
  function renderStaticDuringPour(from,to,pouringGlass){
    const fromStack=pouringGlass.querySelector('.liquidStack');
    const unit=(100/CAPACITY).toFixed(4)+'%';
    fromStack.innerHTML=''; state[from].forEach(c=>{const d=document.createElement('div');d.className='layer '+c;d.style.height=unit;d.style.flex='0 0 '+unit;fromStack.appendChild(d)});
    const t=document.querySelector('.slot[data-i="'+to+'"] .liquidStack');
    if(t){t.innerHTML='';state[to].forEach(c=>{const d=document.createElement('div');d.className='layer '+c;d.style.height=unit;d.style.flex='0 0 '+unit;t.appendChild(d)});}
  }

  function checkWin(){ return checkWinState(state); }
  function undo(){
    if(busy || paused || gameOver || !history.length) return;
    const h=history.pop();
    state=clone(h.state);
    moves=h.moves;
    selected=null;
    busy=false;
    render();
    clickTone(260,.07);
    showToast('Última jogada desfeita.');
  }
  function reset(){
    if(busy)return;
    initialState=generateRound();
    state=clone(initialState);
    history=[];
    moves=0;
    elapsed=0;
    timeLeft=TOTAL_TIME;
    lastTickWarn=null;
    selected=null;
    paused=false;
    gameOver=false;
    stopTimer();
    render();
    hideModal('pauseModal'); hideModal('helpModal'); hideModal('rankingModal'); hideModal('winModal'); hideModal('loseModal');
    clickTone(300,.05);
    if(game.style.display==='flex'){ startTimer(); startArcadeMusic(); }
  }
  function win(){
    if(gameOver) return;
    gameOver=true;
    stopTimer();
    stopArcadeMusic();
    document.getElementById('finalPlayer').textContent=playerName||'Jogador';
    document.getElementById('finalMoves').textContent=moves;
    document.getElementById('finalTime').textContent=formatTime(elapsed);
    addRankingEntry();
    showModal('winModal');
    victorySound();
  }
  function lose(){
    if(gameOver) return;
    gameOver=true;
    stopTimer();
    stopArcadeMusic();
    timeLeft=0;
    updateTime();
    document.getElementById('losePlayer').textContent=playerName||'Jogador';
    document.getElementById('loseMoves').textContent=moves;
    document.getElementById('loseTime').textContent=formatTime(elapsed);
    showModal('loseModal');
    defeatSound();
  }
  function showToast(msg){toast.textContent=msg;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),1300)}
  function showModal(id){document.getElementById(id).classList.add('show')}
  function hideModal(id){document.getElementById(id).classList.remove('show')}
  function sleep(ms){return new Promise(r=>setTimeout(r,ms))}

  function startGame(){ if(!playerName){ askPlayerName(); return; } cover.style.display='none'; game.style.display='flex'; playerBadge.textContent='Jogador: '+playerName; ensureAudio(); reset(); startArcadeMusic(); renderRanking(); showToast('Você tem 2 minutos. Nos 5 segundos finais o tic-tac será ativado.'); }
  function goHome(){ if(busy)return; stopTimer(); stopArcadeMusic(); game.style.display='none'; cover.style.display='flex'; hideModal('pauseModal'); hideModal('helpModal'); hideModal('rankingModal'); hideModal('winModal'); hideModal('loseModal'); paused=false; gameOver=false; }
  function togglePause(){ if(busy || gameOver)return; paused=true; stopTimer(); stopArcadeMusic(); showModal('pauseModal'); clickTone(210,.05); }

  function ensureAudio(){ try{ if(!audioCtx) audioCtx=new (window.AudioContext||window.webkitAudioContext)(); if(audioCtx.state==='suspended') audioCtx.resume(); }catch(e){} }
  function clickTone(freq,dur){try{ensureAudio();const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.frequency.value=freq;o.type='sine';g.gain.setValueAtTime(.08,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+dur);o.connect(g).connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+dur)}catch(e){}}
  function musicNote(freq,dur=.13,vol=.026,type='square'){
    try{
      ensureAudio();
      if(!audioCtx || !freq) return;
      const now=audioCtx.currentTime;
      const o=audioCtx.createOscillator(), g=audioCtx.createGain();
      o.type=type;
      o.frequency.setValueAtTime(freq,now);
      g.gain.setValueAtTime(.0001,now);
      g.gain.exponentialRampToValueAtTime(vol,now+.012);
      g.gain.exponentialRampToValueAtTime(.001,now+dur);
      o.connect(g).connect(audioCtx.destination);
      o.start(now);
      o.stop(now+dur+.02);
    }catch(e){}
  }
  function startArcadeMusic(){
    if(musicTimer || paused || gameOver || game.style.display!=='flex') return;
    ensureAudio();
    const melody=[523,659,784,659,587,698,880,698,523,659,784,988,880,784,659,587];
    const bass=[131,131,147,147,165,165,147,147];
    musicStep=musicStep%melody.length;
    const playStep=()=>{
      if(paused || gameOver || game.style.display!=='flex') return;
      const m=melody[musicStep%melody.length];
      musicNote(m,.135,.024,'square');
      if(musicStep%2===0) musicNote(bass[(musicStep/2)%bass.length],.20,.018,'triangle');
      if(musicStep%4===2) musicNote(m/2,.09,.010,'square');
      musicStep=(musicStep+1)%melody.length;
    };
    playStep();
    musicTimer=setInterval(playStep,180);
  }
  function stopArcadeMusic(){
    if(musicTimer){ clearInterval(musicTimer); musicTimer=null; }
  }
  let noiseNode=null;
  function pourSound(on){try{ensureAudio(); if(on){
      const len=audioCtx.sampleRate*.6, buf=audioCtx.createBuffer(1,len,audioCtx.sampleRate), data=buf.getChannelData(0); for(let i=0;i<len;i++) data[i]=(Math.random()*2-1)*.35;
      const src=audioCtx.createBufferSource(),f=audioCtx.createBiquadFilter(),g=audioCtx.createGain();src.buffer=buf;src.loop=true;f.type='bandpass';f.frequency.value=900;f.Q.value=.5;g.gain.value=.055;src.connect(f).connect(g).connect(audioCtx.destination);src.start();noiseNode=src;
    } else if(noiseNode){noiseNode.stop();noiseNode=null}
  }catch(e){}}
  function completionTone(){try{ensureAudio();[520,660,780].forEach((f,i)=>setTimeout(()=>clickTone(f,.10),i*80))}catch(e){}}
  function arcadePhrase(notes, dur=.12, type='square'){ try{ ensureAudio(); notes.forEach((f,i)=>{ setTimeout(()=>{ const now=audioCtx.currentTime; const o=audioCtx.createOscillator(), g=audioCtx.createGain(); o.type=type; o.frequency.value=f; g.gain.setValueAtTime(.0001, now); g.gain.exponentialRampToValueAtTime(.09, now+.01); g.gain.exponentialRampToValueAtTime(.001, now+dur); o.connect(g).connect(audioCtx.destination); o.start(now); o.stop(now+dur); }, i*(dur*1000*0.95)); }); }catch(e){} }
  function victorySound(){ arcadePhrase([523,659,784,988,1175,1319], .16, 'square'); }
  function defeatSound(){ arcadePhrase([660,622,587,523,466,392,349], .17, 'sawtooth'); }

  function bindTap(id, handler){
    const el=document.getElementById(id);
    if(!el) return;
    let lastFire=0;
    const fire=(e)=>{
      const now=Date.now();
      if(now-lastFire<350) return;
      lastFire=now;
      if(e && e.cancelable) e.preventDefault();
      handler(e);
    };
    el.addEventListener('pointerup',fire,{passive:false});
    el.addEventListener('click',fire,{passive:false});
  }

  bindTap('startHotspot',askPlayerName);
  bindTap('rankingHotspot',openRanking);
  bindTap('howHotspot',openHelp);
  bindTap('confirmNameBtn',confirmPlayerName);
  bindTap('cancelNameBtn',()=>{hideModal('nameModal');nameError.textContent=''});
  if(playerNameInput) playerNameInput.addEventListener('keydown',e=>{if(e.key==='Enter')confirmPlayerName()});
  if(undoTopBtn) bindTap('undoTopBtn',undo);
  bindTap('pauseBtn',togglePause);
  bindTap('rankingBtn',openRanking);
  bindTap('resumeBtn',()=>{paused=false;hideModal('pauseModal');startTimer();startArcadeMusic()});
  bindTap('pauseResetBtn',reset);
  bindTap('pauseHomeBtn',goHome);
  bindTap('closeHelpBtn',closeHelp);
  bindTap('closeRankingBtn',closeRanking);
  bindTap('clearRankingBtn',()=>{saveRanking([]);renderRanking()});
  bindTap('playAgainBtn',()=>{hideModal('winModal');reset()});
  bindTap('winHomeBtn',goHome);
  bindTap('loseAgainBtn',()=>{hideModal('loseModal');reset()});
  bindTap('loseHomeBtn',goHome);

  initialState=goalState();
  state=clone(initialState);
  renderRanking();
  render();
})();
</script>
</body>
</html>